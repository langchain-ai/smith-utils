##############################################################################
# LangSmith Configuration
# Copy this file to .env and fill in the required values before running:
#   ./smith-fly.sh up -l
#
# Required fields are marked (required).
# Optional fields have defaults or are auto-generated if left blank.
##############################################################################

# ── LangSmith License ────────────────────────────────────────────────────────
# (required) Obtain from https://smith.langchain.com/settings
LicenseKey=

# ── Admin Account ────────────────────────────────────────────────────────────
# (required) Email address for the initial org admin user
initialOrgAdminEmail=

# (optional) Password for the initial org admin user.
#            If left blank, a strong random password is generated and printed
#            at the end of `./smith-fly.sh up -l`.
initialOrgAdminPassword=

# ── Networking ───────────────────────────────────────────────────────────────
# (optional) Custom hostname for LangSmith (e.g. langsmith.internal.example.com).
#            Leave blank to use the ALB-assigned hostname.
LANGSMITH_HOSTNAME=
