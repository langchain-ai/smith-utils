# LangSmith self-hosted configuration
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

initialOrgAdminEmail="admin@example.com"
LicenseKey="your-license-key-here"

# Optional: Custom hostname for LangSmith (leave empty for auto-detection)
# LANGSMITH_HOSTNAME="langsmith.example.com"

# Keycloak OAuth/OIDC — only needed for `--auth keycloak`.
# Bring up Keycloak first with `scripts/keycloak.sh up --ls-host <host>`; it prints
# these values. See docs/keycloak-oauth-scim.md.
# KEYCLOAK_ISSUER_URL="https://keycloak.localhost:8443/realms/langsmith"
# OAUTH_CLIENT_ID="langsmith"
# OAUTH_CLIENT_SECRET="<client secret printed by keycloak.sh>"
# Optional: override default scopes "email,profile,openid" (groups-sync auto-appends ,groups)
# OAUTH_SCOPES="email,profile,openid"
# Optional: pick the OIDC claim that maps to LangSmith's sub when it differs from the
# SCIM externalId (e.g. "oid"). See §5.2.
# ISSUER_SUB_CLAIM_OVERRIDES=""
